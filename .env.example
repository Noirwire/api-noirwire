# Working defaults for local development: Solana devnet, the local Supabase
# stack from `npm run supabase:start`, and no fee relayer. Copy to `.env`.
# Every variable is explained in docs/environment.md.

PORT=4000

# "mainnet" or "devnet". Decides the USDC mint. Required: there is no default.
SOLANA_NETWORK=devnet
# The RPC provider, key included. Optional on devnet, required on mainnet.
# SOLANA_RPC_URL=

# Optional. Raises Jupiter's keyless rate limit.
# JUPITER_API_KEY=

# The origins that may call this API from a browser, comma separated.
ALLOWED_ORIGINS=http://localhost:3999

# 0: no proxy in front (local). 1: the hosting platform's edge (Railway).
TRUSTED_PROXY_HOPS=0
# Shared with the web app's own server only, which may then report the
# browser's address. At least 32 characters.
# EDGE_SHARED_SECRET=

# The most this server asks of each provider a second. Set each below what
# the provider allows your key. The public devnet RPC allows very little.
RPC_PROVIDER_RPS=4
JUPITER_PROVIDER_RPS=1

# Sessions that may be started in an hour: per client address, and in total.
# The service's own defaults are 10 and 600. On one machine every app and
# test suite shares one address, so local development gets room.
SESSION_STARTS_PER_IP_PER_HOUR=500
SESSION_STARTS_PER_HOUR=500

# The identity provider. These are the local stack's address and its
# well-known development keys, which are the same on every machine and
# protect nothing.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Only for a project that still signs sessions with one shared secret.
# SUPABASE_JWT_SECRET=
# A session older than this is refused and not renewed. Default 24.
# SESSION_MAX_AGE_HOURS=24

# The fee relayer. All five or none; see docs/environment.md.
# KORA_URLS=
# KORA_API_KEY=
# KORA_HMAC_SECRET=
# KORA_FEE_PAYERS=
# KORA_PAYMENT_WALLET=
# KORA_ACCOUNT_CREATION=on

# Usage analytics. The first three together, or none.
# UMAMI_URL=
# UMAMI_WEBSITE_ID=
# UMAMI_HOSTNAME=
# ANALYTICS_SALT=
