# Local development: Solana devnet, the local Supabase stack from
# `npm run supabase:start`, no fee relayer. Copy to `.env`.
# Every variable is in docs/environment.md.

SOLANA_NETWORK=devnet
ALLOWED_ORIGINS=http://localhost:3999

# The local stack's address and its well-known development key.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The public devnet RPC allows very little.
RPC_PROVIDER_RPS=4
JUPITER_PROVIDER_RPS=1

# On one machine every app and test suite shares one address.
SESSION_STARTS_PER_IP_PER_HOUR=500
SESSION_STARTS_PER_HOUR=500
